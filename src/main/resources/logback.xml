<!-- The loader's own messages print as plain lines, info on stdout and warnings and
     errors on stderr as "warn: ..." / "error: ...". Libraries log warnings and up only.
     With the OpenTelemetry agent attached, every event is also exported. -->
<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <appender name="INFO" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder><pattern>%msg%n</pattern></encoder>
    </appender>

    <appender name="WARN" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder><pattern>warn: %msg%n%ex</pattern></encoder>
    </appender>

    <appender name="ERROR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder><pattern>error: %msg%n%ex</pattern></encoder>
    </appender>

    <appender name="LIBRARY" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder><pattern>[%thread] %level %logger - %msg%n%ex</pattern></encoder>
    </appender>

    <logger name="ie.rolfe" level="INFO" additivity="false">
        <appender-ref ref="INFO"/>
        <appender-ref ref="WARN"/>
        <appender-ref ref="ERROR"/>
    </logger>

    <root level="WARN">
        <appender-ref ref="LIBRARY"/>
    </root>
</configuration>
