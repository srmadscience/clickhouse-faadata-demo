    {
      "type": "timeseries",
      "title": "Daily activity",
      "description": "Flights per day. Gaps are days the aircraft did not fly.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toDateTime(FlightDate) AS time,\n       countIf(Cancelled = 0) AS Flown,\n       countIf(Cancelled = 1 AND CancellationCode = 'A') AS `Carrier cancellations`,\n       countIf(Cancelled = 1 AND CancellationCode != 'A') AS `Other cancellations`\nFROM faa.ontime WHERE $__dateFilter(FlightDate) AND tail = '${tail}'\nGROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Carrier cancellations"
            },
            "properties": [
              {
