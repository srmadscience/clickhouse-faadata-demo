                "value": "bars"
              },
              {
                "id": "custom.fillOpacity",
                "value": 60
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "7-day average"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10
    },
    {
      "type": "table",
      "title": "Least reliable aircraft",
      "description": "Aircraft with at least the minimum flights, worst carrier-cancellation rate first. Cxl = carrier cancellations; Cxl/1k = per 1,000 flights; Delay min/flt = carrier delay minutes per completed flight; Longest gap = longest run of days without a flight (often heavy maintenance or storage). Click a tail to inspect it below.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT tail AS Tail, any(Reporting_Airline) AS Airline,\n       count() AS Flights,\n       countIf(Cancelled = 1 AND CancellationCode = 'A') AS `Cxl`,\n       round(1000 * Cxl / Flights, 1) AS `Cxl/1k`,\n       round(sum(CarrierDelay) / countIf(Cancelled = 0), 1) AS `Delay min/flt`,\n       countIf(Diverted = 1) AS Diverted,\n       uniqExact(FlightDate) AS `Days flown`,\n       arrayMax(arrayDifference(arraySort(groupUniqArray(toRelativeDayNum(FlightDate))))) - 1\n           AS `Longest gap`,\n       toString(max(FlightDate)) AS `Last flown`\nFROM faa.ontime WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND tail != ''\nGROUP BY tail HAVING Flights >= ${min_flights}\nORDER BY `Cxl/1k` DESC, `Delay min/flt` DESC\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
