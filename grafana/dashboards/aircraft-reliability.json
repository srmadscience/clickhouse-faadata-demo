    {
      "type": "table",
      "title": "Airlines",
      "description": "Per operating airline (regional carriers such as OO SkyWest, MQ Envoy and YX Republic fly for the majors). Flts/day = flights per aircraft per day flown; Cxl/1k = carrier cancellations per 1,000 flights; Delay min/flt = carrier delay minutes per completed flight; Delayed 15+ % = flights with 15+ min carrier delay.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT Reporting_Airline AS Airline,\n       uniqExact(tail) AS Aircraft,\n       round(count() / uniqExact((tail, FlightDate)), 1) AS `Flts/day`,\n       round(1000 * countIf(Cancelled = 1 AND CancellationCode = 'A') / count(), 2) AS `Cxl/1k`,\n       round(sum(CarrierDelay) / countIf(Cancelled = 0), 1) AS `Delay min/flt`,\n       round(100 * countIf(CarrierDelay >= 15) / countIf(Cancelled = 0), 1) AS `Delayed 15+ %`\nFROM faa.ontime WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND tail != ''\nGROUP BY Airline ORDER BY `Cxl/1k`"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cxl/1k"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              },
              {
                "id": "min",
                "value": 0
              },
